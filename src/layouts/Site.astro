---
import { getImage } from 'astro:assets';
import defaultCover from '@/assets/umezawa.webp';
import type { Entry } from '@/lib/entries';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { site } from '@/data/site';
import '@/styles/global.css';
interface Props { title?: string; description?: string; noindex?: boolean; entry?: Entry }
const { entry, title = entry?.data.title, description = entry?.data.description ?? site.description, noindex = entry?.data.draft ?? false } = Astro.props;
const cover = entry?.data.cover;
const card = await getImage({ src: cover?.src ?? defaultCover, width: 1200, height: 630, fit: 'cover', format: 'jpeg' });
const shareImage = new URL(card.src, Astro.site);
const imageAlt = cover?.alt ?? '葛饰北斋《相州梅泽庄》局部，富士山与山下的鹤群。';
const status = [entry?.data.draft && '草稿', entry?.data.demo && 'Demo'].filter(Boolean).join(' · ');
const pageTitle = [title, status, site.name].filter(Boolean).join(' · ');
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title><meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content={site.name} /><meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />{!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:type" content={entry ? 'article' : 'website'} />
    {entry && <meta property="article:published_time" content={entry.data.date.toISOString()} />}
    {entry?.data.updated && <meta property="article:modified_time" content={entry.data.updated.toISOString()} />}
    <meta property="og:image" content={shareImage} /><meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} /><meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/mark.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>
      try {
        const theme = localStorage.getItem('hikari-theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch { /* 系统主题仍可用 */ }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">跳到正文</a><Header />
    <main id="main" tabindex="-1" class="wrap"><slot /></main><Footer />
  </body>
</html>
