---
import Site from '@/layouts/Site.astro';
import Icon from '@/components/Icon.astro';
import PageIntro from '@/components/PageIntro.astro';
import '@/styles/sections.css';
const modules = [
  {name:'每日待办', icon:'check', detail:'当天需要处理的事项。'},
  {name:'学习计划', icon:'plan', detail:'按阶段安排学习内容。'},
  {name:'考试倒计时', icon:'clock', detail:'集中查看重要日期。'},
  {name:'学习进度', icon:'chart', detail:'回顾每周完成的学习目标。'}
] as const;
---
<Site title="个人工作台" description="个人工作台的公开布局样例。">
  <PageIntro name="个人工作台" en="Desk" description="这是公开的工作台样例。私人任务、计划和统计将来由独立的受保护服务管理。" />
  <div class="section-heading"><h2>工作台模块</h2><small class="demo">Demo</small></div>
  <div class="desk-grid">{modules.map(m => <section><Icon name={m.icon} size={23}/><h3>{m.name}</h3><p>{m.detail}</p></section>)}</div>
</Site>
