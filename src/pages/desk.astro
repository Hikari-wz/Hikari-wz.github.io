---
import Site from '@/layouts/Site.astro';
import Icon from '@/components/Icon.astro';
import PageIntro from '@/components/PageIntro.astro';
import '@/styles/sections.css';
---
<Site title="个人工作台" description="个人工具与学习工作台。">
  <PageIntro name="个人工作台" en="Desk" description="为日常学习和个人项目留一处可以随时回来的地方。" />
  <div class="desk-grid">
    <section>
      <Icon name="plan" size={23} />
      <h2>学习工作台</h2>
      <p>分配一周的学习时间、记录投入，并回顾真正掌握的知识与完成的项目。记录保存在当前设备的浏览器中。</p>
      <a class="button" href="/desk/study/">打开学习工作台</a>
    </section>
    <section>
      <Icon name="book" size={23} />
      <h2>学业中心</h2>
      <p>安排课内复习，记录阶段成果，查看每周投入与下一步。</p>
      <a class="button" href="/desk/academic/">打开学业中心</a>
    </section>
    <section><Icon name="check" size={23} /><h2>每日待办</h2><p>规划中</p></section>
  </div>
</Site>
<style>
  h2 { font: 600 1.4rem var(--serif); }
  .button { margin-top: 1rem; }
</style>
